            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentHandle"
              }
            }
          }
        }
      }
    },
    "/paymenthandles/{id}/cancel": {
      "post": {
        "operationId": "cancelPaymentHandle",
        "summary": "Cancel a payment handle",
        "description": "Invalidates a payment handle before it is consumed.",
