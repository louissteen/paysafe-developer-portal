  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "Base64-encoded `apiUsername:apiPassword` from the Merchant Portal."
      }
    },
    "schemas": {
      "PaymentHandle": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "readOnly": true,
            "example": "8a8195ea-7b0f-4d23-9d4b-2c3f6e1a9b44"
          },
          "merchantRefNum": {
            "type": "string",
            "example": "ref-5f2c1a90",
            "maxLength": 255,
            "description": "Your own unique reference. Reuse it on a retry to avoid a double charge."
          },
          "paymentHandleToken": {
            "type": "string",
            "readOnly": true,
            "example": "SC1a-Hm2T9Kd8pQ"
          },
          "transactionType": {
            "type": "string",
            "enum": [
              "PAYMENT",
              "STANDALONE_CREDIT",
              "VERIFICATION"
            ],
            "example": "PAYMENT"
          },
          "paymentType": {
            "type": "string",
            "enum": [
              "CARD",
              "ACH",
              "EFT",
              "SEPA",
              "SKRILL",
              "NETELLER",
              "PAYPAL",
              "IDEAL",
              "EPS",
              "BLIK",
              "APPLEPAY",
              "GOOGLEPAY"
            ],
            "example": "CARD"
          },
          "status": {
            "type": "string",
            "enum": [
              "INITIATED",
              "PAYABLE",
              "PROCESSING",
              "CONSUMED",
              "EXPIRED",
              "FAILED"
            ],
            "example": "PAYABLE"
          },
          "amount": {
            "$ref": "#/components/schemas/Amount"
          },
          "currencyCode": {
            "$ref": "#/components/schemas/CurrencyCode"
          },
          "card": {
            "$ref": "#/components/schemas/Card"
          },
          "profile": {
            "$ref": "#/components/schemas/Profile"
          },
          "billingDetails": {
            "$ref": "#/components/schemas/BillingDetails"
          },
          "expiryTime": {
            "type": "string",
            "format": "date-time",
            "readOnly": true,
            "description": "15 minutes after creation."
          },
          "txnTime": {
            "type": "string",
            "format": "date-time",
            "readOnly": true,
            "example": "2026-09-11T14:23:05Z"
          },
          "links": {
            "$ref": "#/components/schemas/Links"
          }
        }
      },
      "Amount": {
        "type": "integer",
        "format": "int64",
        "minimum": 1,
        "example": 4999,
        "description": "Amount in the currency's **minor unit**. 4999 is $49.99. See Currency codes for each currency's exponent."
      },
      "CurrencyCode": {
        "type": "string",
        "minLength": 3,
        "maxLength": 3,
        "example": "USD",
        "description": "ISO 4217 currency code."
      },
      "BillingDetails": {
        "type": "object",
        "properties": {
          "street": {
            "type": "string",
            "example": "100 Queen Street West"
          },
          "street2": {
            "type": "string",
            "example": "Suite 3200"
          },
          "city": {
            "type": "string",
            "example": "Toronto"
          },
          "state": {
            "type": "string",
            "example": "ON",
            "description": "ISO 3166-2 subdivision code for US and CA addresses."
          },
          "country": {
            "$ref": "#/components/schemas/CountryCode"
          },
          "zip": {
            "type": "string",
            "example": "M5H 2N2"
          },
          "phone": {
            "type": "string",
            "example": "+1-416-555-0143"
          }
        }
      },
      "CountryCode": {
        "type": "string",
        "minLength": 2,
        "maxLength": 2,
        "example": "CA",
        "description": "ISO 3166-1 alpha-2, uppercase. `GB`, never `UK`."
      },
      "Card": {
        "type": "object",
        "properties": {
          "cardNum": {
            "type": "string",
            "example": "4111111111111111",
            "writeOnly": true,
            "description": "Full card number. Only accepted server-side at SAQ D; prefer a payment handle."
          },
          "lastDigits": {
            "type": "string",
            "example": "1111",
            "readOnly": true
          },
          "cardBin": {
            "type": "string",
            "example": "411111",
            "readOnly": true
          },
          "cardExpiry": {
            "type": "object",
            "properties": {
              "month": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12,
                "example": 11
              },
              "year": {
                "type": "integer",
                "example": 2029
              }
            }
          },
          "cvv": {
            "type": "string",
            "writeOnly": true,
            "example": "123"
          },
          "holderName": {
            "type": "string",
            "example": "Jane Ellery"
          },
          "cardType": {
            "type": "string",
            "enum": [
              "VI",
              "MC",
              "AM",
              "DI",
              "JC",
              "MD",
              "SO",
              "DC"
            ],
            "example": "VI"
          }
        }
      },
      "Links": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "rel": {
              "type": "string",
              "example": "self"
            },
            "href": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "readOnly": true
      },
      "Profile": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "example": "Jane"
          },
          "lastName": {
            "type": "string",
            "example": "Ellery"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "jane.ellery@example.com"
          },
          "phone": {
            "type": "string",
            "example": "+1-416-555-0143"
          },
          "dateOfBirth": {
            "type": "object",
            "properties": {
              "day": {
                "type": "integer",
                "example": 14
              },
              "month": {
                "type": "integer",
                "example": 3
              },
              "year": {
                "type": "integer",
                "example": 1987
              }
            }
          }
        }
      },
      "PaymentMethod": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "readOnly": true,
            "example": "8a8195ea-7b0f-4d23-9d4b-2c3f6e1a9b44"
          },
          "paymentMethod": {
            "type": "string",
            "example": "CARD"
          },
          "currencyCode": {
            "$ref": "#/components/schemas/CurrencyCode"
          },
          "accountId": {
            "type": "string",
            "example": "1002775190"
          },
          "countries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CountryCode"
            },
            "example": [
              "CA",
              "US",
              "GB"
            ]
          },
          "minimumAmount": {
            "$ref": "#/components/schemas/Amount"
          },
          "maximumAmount": {
            "$ref": "#/components/schemas/Amount"
          },
          "requiresRedirect": {
            "type": "boolean",
            "example": false
          }
        }
      },
      "Redirect": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "readOnly": true,
            "example": "8a8195ea-7b0f-4d23-9d4b-2c3f6e1a9b44"
          },
          "rel": {
            "type": "string",
            "enum": [
              "redirect_payment",
              "on_completed",
              "on_failed",
              "default"
            ],
            "example": "redirect_payment"
          },
          "href": {
            "type": "string",
            "format": "uri",
            "example": "https://api.test.paysafe.com/redirect/8a8195ea"
          },
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST"
            ],
            "example": "GET"
          },
          "returnUrl": {
            "type": "string",
            "format": "uri",
            "example": "https://example.com/checkout/return"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "COMPLETED",
              "FAILED"
            ],
            "example": "PENDING"
          }
        }
      },
      "Simulation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "readOnly": true,
            "example": "8a8195ea-7b0f-4d23-9d4b-2c3f6e1a9b44"
          },
          "merchantRefNum": {
            "type": "string",
            "example": "test-held-flow"
          },
          "forceStatus": {
            "type": "string",
            "enum": [
              "COMPLETED",
              "FAILED",
              "HELD",
              "PENDING"
            ],
            "example": "HELD"
          },
          "forceErrorCode": {
            "type": "string",
            "nullable": true,
            "example": "3023"
          },
          "consumed": {
            "type": "boolean",
            "readOnly": true,
            "example": false
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "5068",
                "description": "Stable machine-readable code. Branch on this, not on `message`."
              },
              "message": {
                "type": "string",
                "example": "Either you submitted a request that is missing a mandatory field or the value of a field does not match the format expected."
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "fieldErrors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string",
                      "example": "card.cardNum"
                    },
                    "error": {
                      "type": "string",
                      "example": "Invalid card number"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "offset": {
            "type": "integer",
            "example": 0
          },
          "limit": {
            "type": "integer",
            "example": 10
          },
          "totalItems": {
            "type": "integer",
            "example": 137
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request \u2014 a field is missing or malformed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Authentication failed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Declined": {
        "description": "The transaction was declined.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "The resource was not found.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Conflict": {
        "description": "Duplicate `merchantRefNum`.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ServerError": {
        "description": "Unexpected error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "parameters": {
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "default": 10,
          "maximum": 100
        },
        "description": "Number of records to return."
      },
      "Offset": {
        "name": "offset",
        "in": "query",
        "schema": {
          "type": "integer",
          "default": 0
        },
        "description": "Zero-based index of the first record to return."
      },
      "MerchantRefNum": {
        "name": "merchantRefNum",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "Filter by your own reference number."
      }
    }
  }
}