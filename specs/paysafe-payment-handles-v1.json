{
  "openapi": "3.0.3",
  "info": {
    "title": "Paysafe Payment Handles API",
    "version": "1.0.0",
    "description": "A payment handle is a single-use token representing a customer's chosen payment instrument. It is the modern entry point to the Payments API and keeps raw instrument data out of your servers.",
    "contact": {
      "name": "Paysafe Developer Support",
      "url": "https://developer.paysafe.com/en/support/"
    },
    "license": {
      "name": "Paysafe API Terms",
      "url": "https://www.paysafe.com/en/legal/"
    }
  },
  "servers": [
    {
      "url": "https://api.test.paysafe.com/paymenthub/v1",
      "description": "Test \u2014 no funds move"
    },
    {
      "url": "https://api.paysafe.com/paymenthub/v1",
      "description": "Production"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "tags": [
    {
      "name": "Payment handles",
      "description": "Operations on paymenthandles."
    },
    {
      "name": "Redirects",
      "description": "Handle customer redirects for methods that require an off-site step."
    },
    {
      "name": "Payment methods",
      "description": "Discover which payment methods are available for a given context."
    },
    {
      "name": "Simulated responses",
      "description": "Drive deterministic outcomes in the test environment."
    }
  ],
  "paths": {
    "/paymenthandles": {
      "post": {
        "operationId": "createPaymentHandle",
        "summary": "Create a payment handle",
        "description": "Creates a new payment handle. Supply a unique `merchantRefNum` so the request can be safely retried.",
        "tags": [
          "Payment handles"
        ],
        "responses": {
          "201": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentHandle"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "$ref": "#/components/responses/Declined"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentHandle"
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listPaymentHandles",
        "summary": "List payment handles",
        "description": "Returns a paginated list of payment handles, most recent first.",
        "tags": [
          "Payment handles"
        ],
        "responses": {
          "200": {
            "description": "A paginated list.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "meta": {
                      "$ref": "#/components/schemas/Pagination"
                    },
                    "paymentHandles": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PaymentHandle"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Offset"
          },
          {
            "$ref": "#/components/parameters/MerchantRefNum"
          }
        ]
      }
    },
    "/paymenthandles/{id}": {
      "get": {
        "operationId": "getPaymentHandle",
        "summary": "Get a payment handle",
        "description": "Retrieves a single payment handle by its Paysafe id.",
