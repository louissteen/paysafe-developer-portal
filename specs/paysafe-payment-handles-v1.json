    },
    "/paymenthandles/{paymentHandleId}/redirect": {
      "get": {
        "operationId": "getRedirect",
        "summary": "Get redirect details",
        "description": "Returns the URL the customer must be sent to in order to complete authentication or authorization.",
        "tags": [
          "Redirects"
        ],
        "responses": {
          "200": {
            "description": "A paginated list.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "meta": {
                      "$ref": "#/components/schemas/Pagination"
                    },
                    "redirects": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Redirect"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "parameters": [
          {
            "name": "paymentHandleId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unique identifier of the paymentHandle.",
            "example": "8a8195ea-7b0f-4d23-9d4b-2c3f6e1a9b44"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Offset"
          },
          {
            "$ref": "#/components/parameters/MerchantRefNum"
          }
        ]
      }
    },
