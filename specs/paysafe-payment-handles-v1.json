            "$ref": "#/components/responses/ServerError"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unique identifier of the payment handle.",
            "example": "8a8195ea-7b0f-4d23-9d4b-2c3f6e1a9b44"
