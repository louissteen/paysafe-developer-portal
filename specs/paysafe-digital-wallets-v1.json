  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "Base64-encoded `apiUsername:apiPassword` from the Merchant Portal."
      }
    },
    "schemas": {
      "OnRampAsset": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "example": "BTC"
          },
          "name": {
            "type": "string",
            "example": "Bitcoin"
          },
          "minimumFiatAmount": {
            "$ref": "#/components/schemas/Amount"
          },
          "maximumFiatAmount": {
            "$ref": "#/components/schemas/Amount"
          },
          "availableInCountries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CountryCode"
            },
            "example": [
              "GB",
              "DE",
              "FR"
            ]
          },
          "decimals": {
            "type": "integer",
            "example": 8
          }
        }
      },
      "Amount": {
        "type": "integer",
        "format": "int64",
        "minimum": 1,
        "example": 4999,
        "description": "Amount in the currency's **minor unit**. 4999 is $49.99. See Currency codes for each currency's exponent."
      },
      "CountryCode": {
        "type": "string",
        "minLength": 2,
        "maxLength": 2,
        "example": "CA",
        "description": "ISO 3166-1 alpha-2, uppercase. `GB`, never `UK`."
      },
      "OnRampOrder": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "readOnly": true,
            "example": "8a8195ea-7b0f-4d23-9d4b-2c3f6e1a9b44"
          },
          "quoteId": {
            "type": "string",
            "example": "8a8195ea-7b0f-4d23-9d4b-2c3f6e1a9b44"
          },
          "merchantRefNum": {
            "type": "string",
            "example": "ref-5f2c1a90",
            "maxLength": 255,
            "description": "Your own unique reference. Reuse it on a retry to avoid a double charge."
          },
          "asset": {
            "type": "string",
            "example": "BTC"
          },
          "assetAmount": {
            "type": "string",
            "example": "0.00142317",
            "readOnly": true
          },
          "fiatAmount": {
            "$ref": "#/components/schemas/Amount"
          },
          "fiatCurrency": {
            "$ref": "#/components/schemas/CurrencyCode"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "PROCESSING",
              "COMPLETED",
              "FAILED"
            ],
            "example": "COMPLETED"
          },
          "txnTime": {
            "type": "string",
            "format": "date-time",
            "readOnly": true,
            "example": "2026-09-11T14:23:05Z"
          }
        }
      },
      "CurrencyCode": {
        "type": "string",
        "minLength": 3,
        "maxLength": 3,
        "example": "USD",
        "description": "ISO 4217 currency code."
      },
      "OnRampQuote": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "readOnly": true,
            "example": "8a8195ea-7b0f-4d23-9d4b-2c3f6e1a9b44"
          },
          "fiatAmount": {
            "$ref": "#/components/schemas/Amount"
          },
          "fiatCurrency": {
            "$ref": "#/components/schemas/CurrencyCode"
          },
          "asset": {
            "type": "string",
            "example": "BTC"
          },
          "assetAmount": {
            "type": "string",
            "example": "0.00142317",
            "readOnly": true,
            "description": "Decimal string \u2014 crypto precision exceeds IEEE 754 doubles."
          },
          "rate": {
            "type": "string",
            "example": "70265.41",
            "readOnly": true
          },
          "feeAmount": {
            "$ref": "#/components/schemas/Amount"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true,
            "description": "Quotes are valid for 60 seconds."
          },
          "valid": {
            "type": "boolean",
            "readOnly": true,
            "example": true
          }
        }
      },
      "Payout": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "readOnly": true,
            "example": "8a8195ea-7b0f-4d23-9d4b-2c3f6e1a9b44"
          },
          "merchantRefNum": {
            "type": "string",
            "example": "ref-5f2c1a90",
            "maxLength": 255,
            "description": "Your own unique reference. Reuse it on a retry to avoid a double charge."
          },
          "status": {
            "type": "string",
            "enum": [
              "RECEIVED",
              "PENDING",
              "PROCESSING",
              "HELD",
              "COMPLETED",
              "FAILED",
              "CANCELLED"
            ],
            "example": "COMPLETED"
          },
          "txnTime": {
            "type": "string",
            "format": "date-time",
            "readOnly": true,
            "example": "2026-09-11T14:23:05Z"
          },
          "amount": {
            "$ref": "#/components/schemas/Amount"
          },
          "currencyCode": {
            "$ref": "#/components/schemas/CurrencyCode"
          },
          "links": {
            "$ref": "#/components/schemas/Links"
          },
          "walletType": {
            "type": "string",
            "enum": [
              "SKRILL",
              "NETELLER"
            ],
            "example": "SKRILL"
          },
          "recipientEmail": {
            "type": "string",
            "format": "email",
            "example": "jane.ellery@example.com"
          },
          "recipientWalletId": {
            "type": "string",
            "example": "NET-8891023"
          },
          "feeAmount": {
            "$ref": "#/components/schemas/Amount"
          },
          "note": {
            "type": "string",
            "example": "August affiliate payout"
          }
        }
      },
      "Links": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "rel": {
              "type": "string",
              "example": "self"
            },
            "href": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "readOnly": true
      },
      "WalletCustomer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "readOnly": true,
            "example": "8a8195ea-7b0f-4d23-9d4b-2c3f6e1a9b44"
          },
          "merchantCustomerId": {
            "type": "string",
            "example": "cust-1481"
          },
          "walletType": {
            "type": "string",
            "enum": [
              "SKRILL",
              "NETELLER"
            ],
            "example": "SKRILL"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "jane.ellery@example.com"
          },
          "walletId": {
            "type": "string",
            "example": "NET-8891023",
            "readOnly": true
          },
          "verified": {
            "type": "boolean",
            "example": true,
            "readOnly": true
          },
          "country": {
            "$ref": "#/components/schemas/CountryCode"
          }
        }
      },
      "WalletPayment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "readOnly": true,
            "example": "8a8195ea-7b0f-4d23-9d4b-2c3f6e1a9b44"
          },
          "merchantRefNum": {
            "type": "string",
            "example": "ref-5f2c1a90",
            "maxLength": 255,
            "description": "Your own unique reference. Reuse it on a retry to avoid a double charge."
          },
          "status": {
            "type": "string",
            "enum": [
              "RECEIVED",
              "PENDING",
              "PROCESSING",
              "HELD",
              "COMPLETED",
              "FAILED",
              "CANCELLED"
            ],
            "example": "COMPLETED"
          },
          "txnTime": {
            "type": "string",
            "format": "date-time",
            "readOnly": true,
            "example": "2026-09-11T14:23:05Z"
          },
          "amount": {
            "$ref": "#/components/schemas/Amount"
          },
          "currencyCode": {
            "$ref": "#/components/schemas/CurrencyCode"
          },
          "links": {
            "$ref": "#/components/schemas/Links"
          },
          "walletType": {
            "type": "string",
            "enum": [
              "SKRILL",
              "NETELLER"
            ],
            "example": "SKRILL"
          },
          "customerEmail": {
            "type": "string",
            "format": "email",
            "example": "jane.ellery@example.com"
          },
          "redirectUrl": {
            "type": "string",
            "format": "uri",
            "readOnly": true
          },
          "capturedAmount": {
            "$ref": "#/components/schemas/Amount"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "5068",
                "description": "Stable machine-readable code. Branch on this, not on `message`."
              },
              "message": {
                "type": "string",
                "example": "Either you submitted a request that is missing a mandatory field or the value of a field does not match the format expected."
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "fieldErrors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string",
                      "example": "card.cardNum"
                    },
                    "error": {
                      "type": "string",
                      "example": "Invalid card number"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "offset": {
            "type": "integer",
            "example": 0
          },
          "limit": {
            "type": "integer",
            "example": 10
          },
          "totalItems": {
            "type": "integer",
            "example": 137
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request \u2014 a field is missing or malformed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Authentication failed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Declined": {
        "description": "The transaction was declined.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "The resource was not found.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Conflict": {
        "description": "Duplicate `merchantRefNum`.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ServerError": {
        "description": "Unexpected error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "parameters": {
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "default": 10,
          "maximum": 100
        },
        "description": "Number of records to return."
      },
      "Offset": {
        "name": "offset",
        "in": "query",
        "schema": {
          "type": "integer",
          "default": 0
        },
        "description": "Zero-based index of the first record to return."
      },
      "MerchantRefNum": {
        "name": "merchantRefNum",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "Filter by your own reference number."
      }
    }
  }
}