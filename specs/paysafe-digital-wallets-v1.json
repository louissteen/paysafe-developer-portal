{
  "openapi": "3.0.3",
  "info": {
    "title": "Paysafe Digital Wallets API",
    "version": "1.0.0",
    "description": "Accept payments from Skrill and NETELLER digital wallets, and pay out to them. Includes Crypto On-Ramp for fiat-to-crypto purchases.\n\n---\n\n**DEMO SPECIFICATION \u2014 NOT A REAL PAYSAFE API.** This document was generated for a GitBook proof of concept. The endpoints, schemas and examples are fabricated and describe no live Paysafe system. For the real Paysafe API, see https://developer.paysafe.com.",
    "contact": {
      "name": "Paysafe Developer Support",
      "url": "https://developer.paysafe.com/en/support/"
    },
    "license": {
      "name": "Paysafe API Terms",
      "url": "https://www.paysafe.com/en/legal/"
    }
  },
  "servers": [
    {
      "url": "https://api.test.paysafe.com/digitalwallets/v1",
      "description": "Test \u2014 no funds move"
    },
    {
      "url": "https://api.paysafe.com/digitalwallets/v1",
      "description": "Production"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "tags": [
    {
      "name": "Wallet payments",
      "description": "Operations on payments."
    },
    {
      "name": "Payouts",
      "description": "Operations on payouts."
    },
    {
      "name": "Customers",
      "description": "Operations on customers."
    },
    {
      "name": "Crypto On-Ramp",
      "description": "Let customers buy cryptocurrency with fiat held in a Skrill wallet."
    }
  ],
  "paths": {
    "/payments": {
      "post": {
        "operationId": "createWalletPayment",
        "summary": "Create a wallet payment",
        "description": "Creates a new wallet payment. Supply a unique `merchantRefNum` so the request can be safely retried.",
        "tags": [
          "Wallet payments"
        ],
        "responses": {
          "201": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalletPayment"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "$ref": "#/components/responses/Declined"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WalletPayment"
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listWalletPayments",
        "summary": "List wallet payments",
        "description": "Returns a paginated list of wallet payments, most recent first.",
        "tags": [
          "Wallet payments"
        ],
        "responses": {
          "200": {
            "description": "A paginated list.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "meta": {
                      "$ref": "#/components/schemas/Pagination"
                    },
                    "payments": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/WalletPayment"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Offset"
          },
          {
            "$ref": "#/components/parameters/MerchantRefNum"
          }
        ]
      }
    },
