  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "Base64-encoded `apiUsername:apiPassword` from the Merchant Portal."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "5068"
              },
              "message": {
                "type": "string",
                "example": "Either you submitted a request that is missing a mandatory field or the value of a field does not match the format expected."
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "fieldErrors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string",
                      "example": "card.cardNum"
                    },
                    "error": {
                      "type": "string",
                      "example": "Invalid card number"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "Amount": {
        "type": "integer",
        "format": "int64",
        "minimum": 1,
        "description": "Amount in the currency's minor unit (see Currency codes).",
        "example": 4999
      },
      "CurrencyCode": {
        "type": "string",
        "minLength": 3,
        "maxLength": 3,
        "example": "USD"
      },
      "BillingDetails": {
        "type": "object",
        "properties": {
          "street": {
            "type": "string",
            "example": "100 Queen Street West"
          },
          "street2": {
            "type": "string",
            "example": "Suite 3200"
          },
          "city": {
            "type": "string",
            "example": "Toronto"
          },
          "state": {
            "type": "string",
            "example": "ON"
          },
          "country": {
            "type": "string",
            "example": "CA"
          },
          "zip": {
            "type": "string",
            "example": "M5H 2N2"
          },
          "phone": {
            "type": "string",
            "example": "+1-416-555-0143"
          }
        }
      },
      "Card": {
        "type": "object",
        "properties": {
          "cardNum": {
            "type": "string",
