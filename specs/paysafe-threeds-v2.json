{
  "openapi": "3.0.3",
  "info": {
    "title": "Paysafe 3D Secure API",
    "version": "1.0.0",
    "description": "EMV 3-D Secure 2.x authentication. Run frictionless and challenge flows to shift liability for fraudulent chargebacks and meet PSD2 SCA requirements.",
    "contact": {
      "name": "Paysafe Developer Support",
      "url": "https://developer.paysafe.com/en/support/"
    },
    "license": {
      "name": "Paysafe API Terms",
      "url": "https://www.paysafe.com/en/legal/"
    }
  },
  "servers": [
    {
      "url": "https://api.test.paysafe.com/threedsecure/v2",
      "description": "Test \u2014 no funds move"
    },
    {
      "url": "https://api.paysafe.com/threedsecure/v2",
      "description": "Production"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "tags": [
    {
      "name": "Authentications",
      "description": "Operations on authentications."
    },
    {
      "name": "Enrollment checks",
      "description": "Operations on enrollmentchecks."
    },
    {
      "name": "Device fingerprinting",
      "description": "Collect browser and device signals used by the issuer's risk engine."
    },
    {
      "name": "Exemptions",
      "description": "Request SCA exemptions permitted under PSD2."
    }
  ],
  "paths": {
    "/authentications": {
      "post": {
        "operationId": "createAuthentication",
        "summary": "Create an authentication",
        "description": "Creates a new authentication. Supply a unique `merchantRefNum` so the request can be safely retried.",
        "tags": [
          "Authentications"
        ],
        "responses": {
          "201": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Authentication"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "$ref": "#/components/responses/Declined"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Authentication"
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listAuthentications",
        "summary": "List authentications",
        "description": "Returns a paginated list of authentications, most recent first.",
        "tags": [
          "Authentications"
        ],
        "responses": {
          "200": {
            "description": "A paginated list.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "meta": {
                      "$ref": "#/components/schemas/Pagination"
                    },
                    "authentications": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Authentication"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Offset"
          },
          {
            "$ref": "#/components/parameters/MerchantRefNum"
          }
        ]
      }
    },
