  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "Base64-encoded `apiUsername:apiPassword` from the Merchant Portal."
      }
    },
    "schemas": {
      "Authentication": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "readOnly": true,
            "example": "8a8195ea-7b0f-4d23-9d4b-2c3f6e1a9b44"
          },
          "merchantRefNum": {
            "type": "string",
            "example": "ref-5f2c1a90",
            "maxLength": 255,
            "description": "Your own unique reference. Reuse it on a retry to avoid a double charge."
          },
          "card": {
            "$ref": "#/components/schemas/Card"
          },
          "amount": {
            "$ref": "#/components/schemas/Amount"
          },
          "currencyCode": {
            "$ref": "#/components/schemas/CurrencyCode"
          },
          "deviceFingerprintingId": {
            "type": "string",
            "example": "8a8195ea-7b0f-4d23-9d4b-2c3f6e1a9b44"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "COMPLETED",
              "FAILED",
              "CHALLENGE_REQUIRED"
            ],
            "example": "COMPLETED"
          },
          "cavv": {
            "type": "string",
            "readOnly": true,
            "example": "AAABCZIhcQAAAABZlyFxAAAAAAA=",
            "description": "Cardholder authentication verification value. Pass to the authorization."
          },
          "eci": {
            "type": "string",
            "enum": [
              "00",
              "01",
              "02",
              "05",
              "06",
              "07"
            ],
            "readOnly": true,
            "example": "05",
            "description": "Determines liability shift. See the liability table in the overview."
          },
          "threeDSecureVersion": {
            "type": "string",
            "example": "2.2.0",
            "readOnly": true
          },
          "directoryServerTransactionId": {
            "type": "string",
            "readOnly": true,
            "example": "f38e6948-5388-41a6-bca4-b49723c19437"
          },
          "challengeUrl": {
            "type": "string",
            "format": "uri",
            "nullable": true,
            "readOnly": true
          },
          "txnTime": {
            "type": "string",
            "format": "date-time",
            "readOnly": true,
            "example": "2026-09-11T14:23:05Z"
          }
        }
      },
      "Amount": {
        "type": "integer",
        "format": "int64",
        "minimum": 1,
        "example": 4999,
        "description": "Amount in the currency's **minor unit**. 4999 is $49.99. See Currency codes for each currency's exponent."
      },
      "CurrencyCode": {
        "type": "string",
        "minLength": 3,
        "maxLength": 3,
        "example": "USD",
        "description": "ISO 4217 currency code."
      },
      "Card": {
        "type": "object",
        "properties": {
          "cardNum": {
            "type": "string",
            "example": "4111111111111111",
            "writeOnly": true,
            "description": "Full card number. Only accepted server-side at SAQ D; prefer a payment handle."
          },
          "lastDigits": {
            "type": "string",
            "example": "1111",
            "readOnly": true
          },
          "cardBin": {
            "type": "string",
            "example": "411111",
            "readOnly": true
          },
          "cardExpiry": {
            "type": "object",
            "properties": {
              "month": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12,
                "example": 11
              },
              "year": {
                "type": "integer",
                "example": 2029
              }
            }
          },
          "cvv": {
            "type": "string",
            "writeOnly": true,
            "example": "123"
          },
          "holderName": {
            "type": "string",
            "example": "Jane Ellery"
          },
          "cardType": {
            "type": "string",
            "enum": [
              "VI",
              "MC",
              "AM",
              "DI",
              "JC",
              "MD",
              "SO",
              "DC"
            ],
            "example": "VI"
          }
        }
      },
      "DeviceFingerprint": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "readOnly": true,
            "example": "8a8195ea-7b0f-4d23-9d4b-2c3f6e1a9b44"
          },
          "collectionUrl": {
            "type": "string",
            "format": "uri",
            "readOnly": true,
            "description": "Load this in a hidden iframe to collect device signals."
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "COMPLETED",
              "TIMED_OUT"
            ],
            "example": "COMPLETED"
          },
          "browserDetails": {
            "type": "object",
            "properties": {
              "userAgent": {
                "type": "string"
              },
              "language": {
                "type": "string",
                "example": "en-GB"
              },
              "colorDepth": {
                "type": "integer",
                "example": 24
              },
              "screenHeight": {
                "type": "integer",
                "example": 1080
              },
              "screenWidth": {
                "type": "integer",
                "example": 1920
              },
              "timezoneOffset": {
                "type": "integer",
                "example": -60
              },
              "javaEnabled": {
                "type": "boolean",
                "example": false
              }
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true,
            "example": "2026-09-11T14:23:05Z"
          }
        }
      },
      "Enrollment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "readOnly": true,
            "example": "8a8195ea-7b0f-4d23-9d4b-2c3f6e1a9b44"
          },
          "merchantRefNum": {
            "type": "string",
            "example": "ref-5f2c1a90",
            "maxLength": 255,
            "description": "Your own unique reference. Reuse it on a retry to avoid a double charge."
          },
          "card": {
            "$ref": "#/components/schemas/Card"
          },
          "enrolled": {
            "type": "string",
            "enum": [
              "Y",
              "N",
              "U"
            ],
            "example": "Y",
            "readOnly": true
          },
          "threeDSecureVersion": {
            "type": "string",
            "example": "2.2.0",
            "readOnly": true
          },
          "acsUrl": {
            "type": "string",
            "format": "uri",
            "nullable": true,
            "readOnly": true
          },
          "txnTime": {
            "type": "string",
            "format": "date-time",
            "readOnly": true,
            "example": "2026-09-11T14:23:05Z"
          }
        }
      },
      "Exemption": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "readOnly": true,
            "example": "8a8195ea-7b0f-4d23-9d4b-2c3f6e1a9b44"
          },
          "merchantRefNum": {
            "type": "string",
            "example": "ref-5f2c1a90",
            "maxLength": 255,
            "description": "Your own unique reference. Reuse it on a retry to avoid a double charge."
          },
          "type": {
            "type": "string",
            "enum": [
              "LOW_VALUE",
              "TRANSACTION_RISK_ANALYSIS",
              "TRUSTED_BENEFICIARY",
              "RECURRING",
              "MERCHANT_INITIATED"
            ],
            "example": "LOW_VALUE"
          },
          "amount": {
            "$ref": "#/components/schemas/Amount"
          },
          "currencyCode": {
            "$ref": "#/components/schemas/CurrencyCode"
          },
          "status": {
            "type": "string",
            "enum": [
              "REQUESTED",
              "ACCEPTED",
              "REJECTED"
            ],
            "example": "ACCEPTED",
            "readOnly": true,
            "description": "An exemption is a request. The issuer may still demand a challenge."
          },
          "issuerResponse": {
            "type": "string",
            "nullable": true,
            "readOnly": true
          },
          "txnTime": {
            "type": "string",
            "format": "date-time",
            "readOnly": true,
            "example": "2026-09-11T14:23:05Z"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "5068",
                "description": "Stable machine-readable code. Branch on this, not on `message`."
              },
              "message": {
                "type": "string",
                "example": "Either you submitted a request that is missing a mandatory field or the value of a field does not match the format expected."
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "fieldErrors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string",
                      "example": "card.cardNum"
                    },
                    "error": {
                      "type": "string",
                      "example": "Invalid card number"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "offset": {
            "type": "integer",
            "example": 0
          },
          "limit": {
            "type": "integer",
            "example": 10
          },
          "totalItems": {
            "type": "integer",
            "example": 137
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request \u2014 a field is missing or malformed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Authentication failed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Declined": {
        "description": "The transaction was declined.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "The resource was not found.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Conflict": {
        "description": "Duplicate `merchantRefNum`.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ServerError": {
        "description": "Unexpected error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "parameters": {
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "default": 10,
          "maximum": 100
        },
        "description": "Number of records to return."
      },
      "Offset": {
        "name": "offset",
        "in": "query",
        "schema": {
          "type": "integer",
          "default": 0
        },
        "description": "Zero-based index of the first record to return."
      },
      "MerchantRefNum": {
        "name": "merchantRefNum",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "Filter by your own reference number."
      }
    }
  }
}