          "holderName": {
            "type": "string",
            "example": "Jane Ellery"
          },
          "cardType": {
            "type": "string",
            "enum": [
              "VI",
              "MC",
              "AM",
              "DI",
              "JC",
              "MD",
              "SO",
              "DC"
            ],
            "example": "VI"
          },
